+  IMAGE/factory.bin := \
+	$$(sysupgrade_bin) | check-size $$$$(IMAGE_SIZE) | poray-header -B A5-V11 -F 4M
+  DEVICE_TITLE := Tenda A6
+  DEVICE_PACKAGES := kmod-usb-core kmod-usb-ohci kmod-usb2
+  DEFAULT := n
+endef
+TARGET_DEVICES += a6
+
 define Device/air3gii
   DTS := AIR3GII
   BLOCKSIZE := 64k
